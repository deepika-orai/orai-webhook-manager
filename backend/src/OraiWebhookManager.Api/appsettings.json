{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Retention": {
    "ProcessedInboxRetentionDays": 14,
    "DeadLetterRetentionDays": 30,
    "StatusEventsRetentionDays": 90,
    "AuditLogsRetentionDays": 365
  },
  "WebhookIngestion": {
    "CacheTtlSeconds": 60,
    "MaxPayloadSizeBytes": 1048576,
    "WorkerBatchSize": 100,
    "LeaseDurationSeconds": 120,
    "MaxRetryAttempts": 5,
    "PublicBaseUrl": "http://localhost:5135"
  },
  "GooglePubSub": {
    "UsePubSubBuffer": false,
    "ProjectId": "orai-official",
    "TopicId": "whatsapp-webhook-inbox",
    "SubscriptionId": "whatsapp-webhook-inbox-sub",
    "PublishTimeoutSeconds": 5,
    "SubscriberClientCount": 1,
    "MaxOutstandingElementCount": 100,
    "MaxOutstandingByteCount": 20971520
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  }
}
