# Backend Environment Variables (Placeholders)
# Configuration is managed via appsettings.json and environment variable overrides in ASP.NET Core (.NET 10).

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5135;https://localhost:7036
Cors__AllowedOrigins__0=http://localhost:3000

# Database Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=orai_webhooks;Username=postgres;Password=CHANGE_ME;

# Public API Base URL for Webhook Ingestion Endpoint Generation
WebhookIngestion__PublicBaseUrl=http://localhost:5135

# Google Cloud Pub/Sub Buffer Options (Phase 1 Foundation - Buffer Disabled by Default)
GooglePubSub__UsePubSubBuffer=false
GooglePubSub__ProjectId=orai-official
GooglePubSub__TopicId=whatsapp-webhook-inbox
GooglePubSub__SubscriptionId=whatsapp-webhook-inbox-sub
GooglePubSub__PublishTimeoutSeconds=5
GooglePubSub__SubscriberClientCount=1
GooglePubSub__MaxOutstandingElementCount=100
GooglePubSub__MaxOutstandingByteCount=20971520
